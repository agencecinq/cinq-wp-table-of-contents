{
	"name": "agencecinq/cinq-wp-table-of-contents",
	"description": "Adds unique ids to H2–H6 headings and exposes a nested TOC tree.",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
